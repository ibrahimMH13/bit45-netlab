{
  "name": "BIT 4.5 B Network Management lab",
  "image": "ghcr.io/srl-labs/containerlab/devcontainer-dind-slim:0.81.1",
  "runArgs": ["--privileged"],
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [3000, 9090],
  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "notify" }
  }
}
