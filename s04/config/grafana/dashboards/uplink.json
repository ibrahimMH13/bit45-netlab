{
  "uid": "uplink",
  "title": "MDH uplink",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency pc1 \u2192 srv (ping RTT)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_icmp_duration_seconds{job=\"portal-icmp\",phase=\"rtt\"}",
          "legendFormat": "ping"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Uplink utilisation (r1 eth2 out \u00f7 50 Mbit/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifHCOutOctets{instance=\"172.30.30.2\",ifName=\"eth2\"}[30s]) * 8 / 50e6",
          "legendFormat": "r1 eth2"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Portal page load (HTTP probe)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"portal-http\"}",
          "legendFormat": "http"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ping loss (1 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg_over_time(probe_success{job=\"portal-icmp\"}[1m])",
          "legendFormat": "loss"
        }
      ]
    }
  ]
}
